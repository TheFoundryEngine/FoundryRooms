#!/usr/bin/env sh

echo "Running pre-push checks (unit tests, architecture tests, contract tests, build)..."

# Unit tests
npm test || {
  echo "❌ Unit tests failed. Push aborted."
  echo "Fix failing tests or push with --no-verify to skip (not recommended)."
  exit 1
}

# Architecture boundary tests
npm run arch:test || {
  echo "❌ Architecture boundary tests failed. Push aborted."
  echo "A bounded-context or layering rule was violated. See .dependency-cruiser.js for rules."
  echo "Fix the import or push with --no-verify to skip (not recommended)."
  exit 1
}

# Contract tests
npx vitest run tests/contract --passWithNoTests || npx vitest run tests/contracts --passWithNoTests || {
  echo "❌ Contract tests failed. Push aborted."
  echo "Fix failing contract tests or push with --no-verify to skip (not recommended)."
  exit 1
}

# Build (catches type errors across project references)
npm run build || {
  echo "❌ Build failed. Push aborted."
  echo "Fix build errors or push with --no-verify to skip (not recommended)."
  exit 1
}

echo "✅ Pre-push checks passed."
